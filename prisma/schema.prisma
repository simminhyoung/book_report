generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  password    String
  name        String?
  createdAt   DateTime    @default(now())
  reviews     Review[]
  sessions    Session[]
  likes       Like[]
  comments    Comment[]
  selfReplies SelfReply[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Review {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookTitle   String
  author      String?
  publisher   String?
  coverUrl    String?
  genre       String?
  periodStart String?
  periodEnd   String?
  rating      Int?

  reason      String?
  summary     String?
  quotes      String?
  thoughts    String?
  application String?
  oneLiner    String?
  recommend   String?
  note        String?

  isPublic    Boolean  @default(false)

  likes       Like[]
  comments    Comment[]
  selfReplies SelfReply[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bookTitle])
  @@index([isPublic])
  @@index([genre])
}

model Like {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([reviewId])
}

// A reply the author leaves for themselves on one of their own past reviews —
// powers "과거의 내가 보내는 말" (a past review resurfaces at random and the
// author can answer their past self). Always tied to the review's owner.
model SelfReply {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([reviewId])
}
